{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "rangerrc",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "_command_lines"
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "comment": {
      "type": "PATTERN",
      "value": "#.*"
    },
    "_command_lines": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "single_arg_command"
            },
            {
              "type": "SYMBOL",
              "name": "double_arg_command"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "\\s*"
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "single_arg_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "unmap"
              },
              {
                "type": "STRING",
                "value": "eval"
              },
              {
                "type": "STRING",
                "value": "default_linemode"
              }
            ]
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "PATTERN",
          "value": "\\s+"
        },
        {
          "type": "SYMBOL",
          "name": "argument_value"
        }
      ]
    },
    "double_arg_command": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "set"
              },
              {
                "type": "STRING",
                "value": "setlocal"
              },
              {
                "type": "STRING",
                "value": "map"
              },
              {
                "type": "STRING",
                "value": "cmap"
              },
              {
                "type": "STRING",
                "value": "pmap"
              },
              {
                "type": "STRING",
                "value": "tmap"
              },
              {
                "type": "STRING",
                "value": "copymap"
              },
              {
                "type": "STRING",
                "value": "copycmap"
              },
              {
                "type": "STRING",
                "value": "copypmap"
              },
              {
                "type": "STRING",
                "value": "copytmap"
              },
              {
                "type": "STRING",
                "value": "alias"
              }
            ]
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "PATTERN",
          "value": "\\s+"
        },
        {
          "type": "SYMBOL",
          "name": "argument_key"
        },
        {
          "type": "PATTERN",
          "value": "\\s+"
        },
        {
          "type": "SYMBOL",
          "name": "argument_value"
        }
      ]
    },
    "argument_key": {
      "type": "PATTERN",
      "value": "[^\\s\\n]+"
    },
    "argument_value": {
      "type": "PATTERN",
      "value": "[^\\n]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}